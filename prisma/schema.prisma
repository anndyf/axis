enum QuestaoStatus {
  PENDENTE
  APROVADA
  REJEITADA
}

enum Dificuldade {
  FACIL
  MEDIO
  DIFICIL
}

enum StatusNota {
  APROVADO
  RECUPERACAO
  DESISTENTE
  APROVADO_RECUPERACAO
  APROVADO_CONSELHO
  DEPENDENCIA
  CONSERVADO

  @@map("status_nota")
}

// Link de "esqueci minha senha": guarda só o hash SHA-256 do token (o token
// em si só existe no e-mail), expira e só pode ser usado uma vez.
model TokenRedefinicaoSenha {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  @@index([userId])
  @@map("tokens_redefinicao_senha")
}

// Limitador de tentativas (login errado, pedidos de redefinição de senha):
// uma linha por tentativa, contada numa janela de tempo por `chave`. Fica no
// banco (não em memória) porque o app roda em várias instâncias serverless.
model TentativaAcesso {
  id       String   @id @default(cuid())
  chave    String
  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([chave, criadoEm])
  @@map("tentativas_acesso")
}

// ---------------------------------------------------------------------------
// Calendário letivo e tempos de aula (plano-avaliacao-frequencia.md, passo 6).
// Base das "aulas previstas": horário da turma × dias letivos do período.
// ---------------------------------------------------------------------------

// Ano (ou semestre) letivo da escola, com início e fim reais.
model PeriodoLetivo {
  id        String            @id @default(cuid())
  escolaId  String            @map("escola_id")
  escola    Escola            @relation(fields: [escolaId], references: [id])
  anoLetivo Int               @map("ano_letivo")
  inicio    DateTime          @db.Date
  fim       DateTime          @db.Date
  etapas    EtapaCalendario[]

  @@unique([escolaId, anoLetivo])
  @@map("periodos_letivos")
}

// Datas de cada etapa (unidade/bimestre) de um esquema naquele ano.
model EtapaCalendario {
  id               String         @id @default(cuid())
  periodoLetivoId  String         @map("periodo_letivo_id")
  periodoLetivo    PeriodoLetivo  @relation(fields: [periodoLetivoId], references: [id], onDelete: Cascade)
  esquemaUnidadeId String         @map("esquema_unidade_id")
  esquemaUnidade   EsquemaUnidade @relation(fields: [esquemaUnidadeId], references: [id], onDelete: Cascade)
  inicio           DateTime       @db.Date
  fim              DateTime       @db.Date
  prazoLancamento  DateTime?      @map("prazo_lancamento") @db.Date

  @@unique([periodoLetivoId, esquemaUnidadeId])
  @@map("etapas_calendario")
}

enum TipoDiaNaoLetivo {
  FERIADO
  RECESSO
  PLANEJAMENTO
  OUTRO
}

// Dia sem aula (feriado, recesso...). turmaId preenchido = só aquela turma.
model DiaNaoLetivo {
  id        String           @id @default(cuid())
  escolaId  String           @map("escola_id")
  escola    Escola           @relation(fields: [escolaId], references: [id])
  data      DateTime         @db.Date
  tipo      TipoDiaNaoLetivo
  descricao String
  turmaId   String?          @map("turma_id")
  turma     Turma?           @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@index([escolaId, data])
  @@map("dias_nao_letivos")
}

// Dia letivo fora da grade normal (sábado letivo, reposição): segue o
// horário de um dia da semana (1 = segunda ... 5 = sexta).
model DiaLetivoExtra {
  id              String   @id @default(cuid())
  escolaId        String   @map("escola_id")
  escola          Escola   @relation(fields: [escolaId], references: [id])
  data            DateTime @db.Date
  seguirHorarioDe Int      @map("seguir_horario_de")
  descricao       String

  @@unique([escolaId, data])
  @@map("dias_letivos_extras")
}

// Grade de tempos da escola por turno: o "horario" (1º, 2º...) de
// HorarioAula é a `ordem` aqui, no turno da turma.
model TempoAula {
  id       String @id @default(cuid())
  escolaId String @map("escola_id")
  escola   Escola @relation(fields: [escolaId], references: [id])
  turno    String // normalizado: MATUTINO | VESPERTINO | NOTURNO | INTEGRAL
  ordem    Int
  inicio   String // "07:00"
  fim      String // "07:50"

  @@unique([escolaId, turno, ordem])
  @@map("tempos_aula")
}

// ---------------------------------------------------------------------------
// Chamada e frequência (plano-avaliacao-frequencia.md, seção 3.4, passos 7-9).
// ---------------------------------------------------------------------------

enum SituacaoAula {
  PREVISTA // chamada aberta, ainda não salva - não conta na frequência
  REALIZADA // chamada salva: conta na frequência
  CANCELADA // aula não dada (ex.: atividade extra, falta do professor)
}

// Registro de aula do diário de classe. Criado sob demanda quando o
// professor abre a chamada, a partir do horário da turma e do calendário.
// POR_AULA: uma linha por (turma, disciplina, dia), com `quantidade` = nº de
// tempos da disciplina naquele dia. POR_DIA: disciplinaId null, quantidade 1.
model Aula {
  id           String       @id @default(cuid())
  escolaId     String       @map("escola_id")
  escola       Escola       @relation(fields: [escolaId], references: [id])
  turmaId      String       @map("turma_id")
  turma        Turma        @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  disciplinaId String?      @map("disciplina_id")
  disciplina   Disciplina?  @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  professorId  String?      @map("professor_id")
  professor    User?        @relation("AulaProfessor", fields: [professorId], references: [id], onDelete: SetNull)
  data         DateTime     @db.Date
  // Tempos do horário cobertos (HorarioAula.horario); vazio na chamada diária
  tempos       Int[]
  quantidade   Int          @default(1)
  conteudo     String? // conteúdo ministrado
  situacao     SituacaoAula @default(PREVISTA)
  // turmaId|data|disciplinaId (ou DIA): garante uma aula por disciplina/dia
  // mesmo com disciplinaId nulo (unique composto não trata null como igual)
  chave        String       @unique
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  faltas       Falta[]

  @@index([escolaId])
  @@index([turmaId, data])
  @@index([disciplinaId])
  @@map("aulas")
}

// Só a exceção é gravada: aluno sem Falta numa aula REALIZADA estava presente.
model Falta {
  id          String    @id @default(cuid())
  aulaId      String    @map("aula_id")
  aula        Aula      @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  estudanteId String    @map("estudante_id")
  estudante   Estudante @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  // nº de tempos perdidos (1..aula.quantidade)
  quantidade  Int       @default(1)

  @@unique([aulaId, estudanteId])
  @@index([estudanteId])
  @@map("faltas")
}

enum TipoJustificativa {
  ATESTADO
  ABONO_LEGAL // ex.: serviço militar, Lei 6.202 (gestante), convocação judicial
  OUTRO
}

enum EfeitoJustificativa {
  ABONA // falta não conta na frequência
  SO_JUSTIFICA // conta, mas fica registrada como justificada
}

// Vale para todas as faltas do aluno no intervalo [inicio, fim] - aplicada
// na hora do cálculo, então cobre faltas lançadas antes ou depois dela.
model Justificativa {
  id              String              @id @default(cuid())
  escolaId        String              @map("escola_id")
  escola          Escola              @relation(fields: [escolaId], references: [id])
  estudanteId     String              @map("estudante_id")
  estudante       Estudante           @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  inicio          DateTime            @db.Date
  fim             DateTime            @db.Date
  tipo            TipoJustificativa
  efeito          EfeitoJustificativa
  descricao       String?
  documentoUrl    String?             @map("documento_url")
  registradoPorId String?             @map("registrado_por_id")
  registradoPor   User?               @relation("JustificativaAutor", fields: [registradoPorId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now()) @map("created_at")

  @@index([escolaId])
  @@index([estudanteId])
  @@map("justificativas")
}

// ---------------------------------------------------------------------------
// Atividades criadas pelo professor (plano-avaliacao-frequencia.md, passo 5).
// Valem quando o esquema da turma tem definicaoAtividades = PROFESSOR: no
// lugar das atividades do template, cada disciplina tem as próprias
// avaliações por etapa. As atividades do template continuam definindo o
// teto da etapa (a nota máxima que a etapa pode valer).
// ---------------------------------------------------------------------------

model AvaliacaoDisciplina {
  id               String          @id @default(cuid())
  disciplinaId     String          @map("disciplina_id")
  disciplina       Disciplina      @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  esquemaUnidadeId String          @map("esquema_unidade_id")
  // Restrict: apagar a etapa não pode levar junto as avaliações do professor
  esquemaUnidade   EsquemaUnidade  @relation(fields: [esquemaUnidadeId], references: [id], onDelete: Restrict)
  nome             String
  data             DateTime?       @db.Date
  notaMaxima       Float           @map("nota_maxima")
  peso             Float           @default(1)
  ordem            Int
  criadoPorId      String?         @map("criado_por_id")
  criadoPor        User?           @relation("AvaliacaoCriador", fields: [criadoPorId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  notas            NotaAvaliacao[]

  @@index([disciplinaId, esquemaUnidadeId])
  @@map("avaliacoes_disciplina")
}

model NotaAvaliacao {
  id            String              @id @default(cuid())
  notaUnidadeId String              @map("nota_unidade_id")
  notaUnidade   NotaUnidade         @relation(fields: [notaUnidadeId], references: [id], onDelete: Cascade)
  avaliacaoId   String              @map("avaliacao_id")
  avaliacao     AvaliacaoDisciplina @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  valor         Float?

  @@unique([notaUnidadeId, avaliacaoId])
  @@index([avaliacaoId])
  @@map("notas_avaliacoes")
}
