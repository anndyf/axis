generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Escola {
  id            String    @id @default(cuid())
  nome          String
  slug          String    @unique
  plano         PlanoTipo @default(BASICO)
  status        String    @default("TRIAL")
  logoUrl       String?   @map("logo_url")
  corPrimaria   String?   @map("cor_primaria")
  corSecundaria String?   @map("cor_secundaria")
  emailDominio  String?   @map("email_dominio")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  users             User[]
  turmas            Turma[]
  cursos            Curso[]
  areasConhecimento AreaConhecimento[]
  laboratorios      Laboratorio[]
  messages          Message[]
  globalConfigs     GlobalConfig[]
  estudantes        Estudante[]
  ocorrencias       Ocorrencia[]
  escolaModulos     EscolaModulo[]
  esquemasAvaliacao EsquemaAvaliacao[]

  @@map("escolas")
}

model EscolaModulo {
  id        String   @id @default(cuid())
  escolaId  String   @map("escola_id")
  escola    Escola   @relation(fields: [escolaId], references: [id])
  moduloId  String   @map("modulo_id")
  ativo     Boolean
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([escolaId, moduloId])
  @@index([escolaId])
  @@map("escola_modulos")
}

enum PlanoTipo {
  BASICO
  PRO
  ENTERPRISE
}

model User {
  id                    String                @id @default(cuid())
  email                 String
  username              String
  password              String
  name                  String?
  escolaId              String                @map("escola_id")
  escola                Escola                @relation(fields: [escolaId], references: [id])
  isSuperuser           Boolean               @default(false) @map("is_superuser")
  isStaff               Boolean               @default(false) @map("is_staff")
  isActive              Boolean               @default(true) @map("is_active")
  isApproved            Boolean               @default(false) @map("is_approved")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  lastLogin             DateTime?             @map("last_login")
  isDirecao             Boolean               @default(false) @map("is_direcao")
  isPortalUser          Boolean               @default(false) @map("is_portal_user")
  estudanteId           String?               @map("estudante_id")
  isAEE                 Boolean               @default(false) @map("is_aee")
  aeeAcknowledgements   AEEAcknowledgement[]
  assignedTickets       Message[]             @relation("AssignedTickets")
  auditLogs             AuditLog[]
  deletedMessages       MessageDelete[]
  readMessages          MessageRead[]
  sentMessages          Message[]             @relation("SentMessages")
  notasModificadas      NotaFinal[]           @relation("NotaModificador")
  auditorias            NotaFinalAudit[]
  simuladosLancados     NotaSimulado[]        @relation("SimuladoLancador")
  ocorrenciasCriadas    Ocorrencia[]          @relation("OcorrenciaAutor")
  planosEnsino          PlanoEnsino[]         @relation("ProfessorPlanos")
  provasCriadas         Prova[]               @relation("ProfessorProvas")
  provasSalvas          Prova[]               @relation("ProvasSalvas")
  questoesComFeedback   Questao[]             @relation("AdminFeedback")
  questoes              Questao[]             @relation("ProfessorQuestoes")
  reservasLaboratorio   ReservaLaboratorio[]
  responsavelSimulados  ResponsavelSimulado[]
  estudante             Estudante?            @relation("UserEstudante", fields: [estudanteId], references: [id])
  disciplinasPermitidas Disciplina[]          @relation("DisciplinaUsuarios")
  turmasPermitidas      Turma[]               @relation("TurmaUsuarios")

  @@unique([escolaId, email])
  @@unique([escolaId, username])
  @@index([escolaId])
  @@map("users")
}

model GlobalConfig {
  id             String   @id
  escolaId       String   @map("escola_id")
  escola         Escola   @relation(fields: [escolaId], references: [id])
  anoLetivoAtual Int      @default(2026) @map("ano_letivo_atual")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([escolaId])
  @@map("configs")
}

model Message {
  id             String          @id @default(cuid())
  ticketNumber   Int             @default(autoincrement()) @map("ticket_number")
  subject        String
  content        String
  escolaId       String          @map("escola_id")
  escola         Escola          @relation(fields: [escolaId], references: [id])
  category       MessageCategory @default(GERAL)
  senderId       String          @map("sender_id")
  receiverId     String?         @map("receiver_id")
  isRead         Boolean         @default(false) @map("is_read")
  isResolved     Boolean         @default(false) @map("is_resolved")
  status         TicketStatus    @default(ABERTO)
  priority       Priority        @default(MEDIA)
  assignedToId   String?         @map("assigned_to_id")
  isGlobal       Boolean         @default(false) @map("is_global")
  createdAt      DateTime        @default(now()) @map("created_at")
  parentId       String?         @map("parent_id")
  internalStatus String?         @map("internal_status")
  allowReplies   Boolean         @default(true) @map("allow_replies")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")
  deletedBy      MessageDelete[]
  readBy         MessageRead[]
  parent         Message?        @relation("MessageReplies", fields: [parentId], references: [id])
  replies        Message[]       @relation("MessageReplies")
  sender         User            @relation("SentMessages", fields: [senderId], references: [id])
  assignedTo     User?           @relation("AssignedTickets", fields: [assignedToId], references: [id])

  @@index([receiverId, createdAt])
  @@index([senderId, createdAt])
  @@index([parentId, createdAt])
  @@index([category, createdAt])
  @@index([isGlobal, createdAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([escolaId])
  @@map("messages")
}

enum TicketStatus {
  ABERTO
  EM_ATENDIMENTO
  AGUARDANDO_RESPOSTA
  RESOLVIDO
  FECHADO
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum MessageCategory {
  COMUNICADO
  SUPORTE
  DIRECAO
  GERAL
  SISTEMA
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  readAt    DateTime @default(now()) @map("read_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_reads")
}

model MessageDelete {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  deletedAt DateTime @default(now()) @map("deleted_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_deletes")
}

model Questao {
  id              String        @id @default(cuid())
  enunciado       String
  imagemUrl       String?       @map("imagem_url")
  muleta          String?
  alternativaA    String
  alternativaB    String
  alternativaC    String
  alternativaD    String
  alternativaE    String
  correta         String
  dificuldade     Dificuldade   @default(MEDIO)
  status          QuestaoStatus @default(PENDENTE)
  feedbackAdmin   String?       @map("feedback_admin")
  professorId     String        @map("professor_id")
  adminFeedbackId String?       @map("admin_feedback_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  unidade         String?
  tipo            String        @default("NORMAL")
  adminFeedback   User?         @relation("AdminFeedback", fields: [adminFeedbackId], references: [id])
  professor       User          @relation("ProfessorQuestoes", fields: [professorId], references: [id])
  provas          Prova[]       @relation("ProvaQuestoes")
  disciplinas     Disciplina[]  @relation("QuestaoDisciplinas")
  turmas          Turma[]       @relation("QuestaoTurmas")

  @@map("questoes")
}

model Prova {
  id                 String    @id @default(cuid())
  codigo             Int       @default(autoincrement())
  titulo             String
  turmaId            String?   @map("turma_id")
  professorCriadorId String?   @map("professor_criador_id")
  savedByUserId      String?   @map("saved_by_user_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  observacao         String?
  questoesSnapshot   Json?     @map("questoes_snapshot")
  unidade            Int?
  tipo               String?   @default("BIMESTRAL")
  areaId             String?   @map("area_id")
  professorCriador   User?     @relation("ProfessorProvas", fields: [professorCriadorId], references: [id])
  savedByUser        User?     @relation("ProvasSalvas", fields: [savedByUserId], references: [id])
  turma              Turma?    @relation(fields: [turmaId], references: [id])
  area               AreaConhecimento? @relation(fields: [areaId], references: [id])
  questoes           Questao[] @relation("ProvaQuestoes")
  notasSimulado      NotaSimulado[]
  responsaveisSimulado ResponsavelSimulado[]

  @@map("provas")
}

model Turma {
  id                   String                @id @default(cuid())
  nome                 String
  escolaId             String                @map("escola_id")
  escola               Escola                @relation(fields: [escolaId], references: [id])
  cursoId              String?               @map("curso_id")
  curso                String?
  turno                String?
  modalidade           String?
  serie                String?
  numero               Int?
  anoLetivo            Int?                  @map("ano_letivo")
  esquemaAvaliacaoId   String?               @map("esquema_avaliacao_id")
  esquemaAvaliacao     EsquemaAvaliacao?     @relation(fields: [esquemaAvaliacaoId], references: [id])
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  disciplinas          Disciplina[]
  estudantes           Estudante[]
  estudantesAnteriores Estudante[]           @relation("TurmaAnteriorEstudante")
  horarios             HorarioAula[]
  provas               Prova[]
  responsavelSimulados ResponsavelSimulado[]
  planosEnsino         PlanoEnsino[]         @relation("PlanoTurmas")
  questoes             Questao[]             @relation("QuestaoTurmas")
  usuariosPermitidos   User[]                @relation("TurmaUsuarios")
  @@index([anoLetivo])
  @@index([escolaId])
  @@map("turmas")
}

model HorarioAula {
  id         String   @id @default(cuid())
  turmaId    String   @map("turma_id")
  diaSemana  Int      @map("dia_semana")
  horario    Int
  disciplina String
  professor  String?
  updatedAt  DateTime @updatedAt @map("updated_at")
  turma      Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([turmaId, diaSemana, horario])
  @@map("horarios_aula")
}

// Classificação livre do nível de ensino (rótulo, sem efeito automático
// no esquema de avaliação por enquanto) - uma escola pode ter cursos em
// vários níveis ao mesmo tempo, ou só um (escola regular de nível único).
enum NivelEnsino {
  FUNDAMENTAL_I
  FUNDAMENTAL_II
  ENSINO_MEDIO
  TECNICO
  EJA
  OUTRO
}

model Curso {
  id                 String            @id @default(cuid())
  nome               String
  sigla              String
  modalidade         String
  nivelEnsino        NivelEnsino?      @map("nivel_ensino")
  turnos             String[]
  escolaId           String            @map("escola_id")
  escola             Escola            @relation(fields: [escolaId], references: [id])
  esquemaAvaliacaoId String?           @map("esquema_avaliacao_id")
  esquemaAvaliacao   EsquemaAvaliacao? @relation(fields: [esquemaAvaliacaoId], references: [id])
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@unique([escolaId, sigla])
  @@unique([escolaId, nome, modalidade])
  @@index([escolaId])
  @@map("cursos")
}

model Estudante {
  id             String         @id @default(cuid())
  matricula      String
  nome           String
  turmaId        String         @map("turma_id")
  escolaId       String         @map("escola_id")
  status         String?        @default("ATIVO")
  turmaAnteriorId String?       @map("turma_anterior_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  dataNascimento DateTime?      @map("data_nascimento")
  sexo           String?        @map("sexo")
  aeeProfile     AEEProfile?    @relation("EstudanteAEE")
  escola         Escola         @relation(fields: [escolaId], references: [id])
  turma          Turma          @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  turmaAnterior  Turma?         @relation("TurmaAnteriorEstudante", fields: [turmaAnteriorId], references: [id])
  notas          NotaFinal[]
  notasSimulado  NotaSimulado[]
  portalAccess   User[]         @relation("UserEstudante")
  ocorrencias    OcorrenciaEstudante[]

  @@unique([escolaId, matricula])
  @@index([nome])
  @@index([turmaId])
  @@index([escolaId])
  @@map("estudantes")
}

model Ocorrencia {
  id              String      @id @default(cuid())
  titulo          String
  descricao       String
  tipo            String
  data            DateTime    @default(now())
  registradoPorId String      @map("registrado_por_id")
  escolaId        String      @map("escola_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  autor           User        @relation("OcorrenciaAutor", fields: [registradoPorId], references: [id])
  escola          Escola      @relation(fields: [escolaId], references: [id])
  estudantes      OcorrenciaEstudante[]

  @@index([data])
  @@index([escolaId])
  @@map("ocorrencias")
}

model OcorrenciaEstudante {
  id           String     @id @default(cuid())
  ocorrenciaId String     @map("ocorrencia_id")
  estudanteId  String     @map("estudante_id")
  ocorrencia   Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
  estudante    Estudante  @relation(fields: [estudanteId], references: [id], onDelete: Cascade)

  @@unique([ocorrenciaId, estudanteId])
  @@map("ocorrencia_estudantes")
}

model Disciplina {
  id                 String            @id @default(cuid())
  nome               String
  turmaId            String            @map("turma_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  areaId             String?           @map("area_id")
  area               AreaConhecimento? @relation(fields: [areaId], references: [id])
  turma              Turma             @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  notas              NotaFinal[]
  usuariosPermitidos User[]            @relation("DisciplinaUsuarios")
  questoes           Questao[]         @relation("QuestaoDisciplinas")
  @@index([turmaId])
  @@map("disciplinas")
}

model NotaFinal {
  id                String           @id @default(cuid())
  estudanteId       String           @map("estudante_id")
  disciplinaId      String           @map("disciplina_id")
  nota              Float
  notaRecuperacao   Float?           @map("nota_recuperacao")
  status            StatusNota
  modifiedById      String?          @map("modified_by_id")
  modifiedAt        DateTime         @default(now()) @map("modified_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  nota1             Float?           @map("nota_1")
  nota2             Float?           @map("nota_2")
  nota3             Float?           @map("nota_3")
  isDesistenteUnid1 Boolean          @default(false) @map("is_desistente_unid1")
  isDesistenteUnid2 Boolean          @default(false) @map("is_desistente_unid2")
  isDesistenteUnid3 Boolean          @default(false) @map("is_desistente_unid3")
  disciplina        Disciplina       @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  estudante         Estudante        @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  modifiedBy        User?            @relation("NotaModificador", fields: [modifiedById], references: [id])
  auditorias        NotaFinalAudit[]
  unidades          NotaUnidade[]

  @@unique([estudanteId, disciplinaId])
  @@index([status])
  @@index([disciplinaId])
  @@map("notas_finais")
}

model NotaFinalAudit {
  id           String     @id @default(cuid())
  notaFinalId  String     @map("nota_final_id")
  notaAnterior Float?     @map("nota_anterior")
  notaAtual    Float      @map("nota_atual")
  status       StatusNota
  modifiedById String?    @map("modified_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  modifiedBy   User?      @relation(fields: [modifiedById], references: [id])
  notaFinal    NotaFinal  @relation(fields: [notaFinalId], references: [id], onDelete: Cascade)

  @@map("notas_finais_audit")
}

enum ModoRecuperacaoUnidade {
  SUBSTITUI_SE_MAIOR
}

enum ModoRecuperacaoFinal {
  SUBSTITUI_MENOR_UNIDADE
  NOTA_MINIMA_ISOLADA
}

// Modelo de avaliação configurável por escola (frente "regras de negócio"
// do plano pré-lançamento). Cada escola pode ter N esquemas (ex: "3
// Unidades" e "Semestral 2 Unidades" convivendo, já que cursos diferentes
// da mesma escola usam modalidades diferentes). Aplicado via
// Turma.esquemaAvaliacaoId (override pontual) ?? Curso.esquemaAvaliacaoId
// (padrão) - resolução feita em código, não no schema.
model EsquemaAvaliacao {
  id                      String                  @id @default(cuid())
  escolaId                String                  @map("escola_id")
  escola                  Escola                  @relation(fields: [escolaId], references: [id])
  nome                    String
  numUnidades             Int                     @map("num_unidades")
  notaMinimaAprovacao     Float                   @default(5) @map("nota_minima_aprovacao")
  recuperacaoUnidadeAtiva Boolean                 @default(false) @map("recuperacao_unidade_ativa")
  modoRecuperacaoUnidade  ModoRecuperacaoUnidade? @map("modo_recuperacao_unidade")
  recuperacaoFinalAtiva   Boolean                 @default(true) @map("recuperacao_final_ativa")
  modoRecuperacaoFinal    ModoRecuperacaoFinal?   @default(SUBSTITUI_MENOR_UNIDADE) @map("modo_recuperacao_final")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  unidades                EsquemaUnidade[]
  cursos                  Curso[]
  turmas                  Turma[]

  @@index([escolaId])
  @@map("esquemas_avaliacao")
}

model EsquemaUnidade {
  id         String             @id @default(cuid())
  esquemaId  String             @map("esquema_id")
  esquema    EsquemaAvaliacao   @relation(fields: [esquemaId], references: [id], onDelete: Cascade)
  ordem      Int
  nome       String
  atividades EsquemaAtividade[]
  notas      NotaUnidade[]

  @@unique([esquemaId, ordem])
  @@map("esquema_unidades")
}

model EsquemaAtividade {
  id               String         @id @default(cuid())
  esquemaUnidadeId String         @map("esquema_unidade_id")
  esquemaUnidade   EsquemaUnidade @relation(fields: [esquemaUnidadeId], references: [id], onDelete: Cascade)
  nome             String
  peso             Float
  ordem            Int
  notas            NotaAtividade[]

  @@map("esquema_atividades")
}

// Nota de uma unidade específica, para um (aluno, disciplina) - substitui
// NotaFinal.nota1/nota2/nota3 fixos. notaCalculada é a soma das atividades
// lançadas (EsquemaAtividade.peso já está na escala final, soma direta).
model NotaUnidade {
  id               String          @id @default(cuid())
  notaFinalId      String          @map("nota_final_id")
  notaFinal        NotaFinal       @relation(fields: [notaFinalId], references: [id], onDelete: Cascade)
  esquemaUnidadeId String          @map("esquema_unidade_id")
  esquemaUnidade   EsquemaUnidade  @relation(fields: [esquemaUnidadeId], references: [id])
  notaCalculada    Float?          @map("nota_calculada")
  notaRecuperacao  Float?          @map("nota_recuperacao")
  isDesistente     Boolean         @default(false) @map("is_desistente")
  atividades       NotaAtividade[]

  @@unique([notaFinalId, esquemaUnidadeId])
  @@map("notas_unidades")
}

model NotaAtividade {
  id                 String           @id @default(cuid())
  notaUnidadeId      String           @map("nota_unidade_id")
  notaUnidade        NotaUnidade      @relation(fields: [notaUnidadeId], references: [id], onDelete: Cascade)
  esquemaAtividadeId String           @map("esquema_atividade_id")
  esquemaAtividade   EsquemaAtividade @relation(fields: [esquemaAtividadeId], references: [id])
  valor              Float?

  @@unique([notaUnidadeId, esquemaAtividadeId])
  @@map("notas_atividades")
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  details    String?
  ipAddress  String?  @map("ip_address")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model PlanoEnsino {
  id             String   @id @default(cuid())
  disciplinaNome String   @map("disciplina_nome")
  periodoInicio  DateTime @map("periodo_inicio")
  periodoFim     DateTime @map("periodo_fim")
  indicadores    String
  conteudos      String
  metodologias   String
  recursos       String
  avaliacao      String
  observacoes    String?
  professorId    String   @map("professor_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  professor      User     @relation("ProfessorPlanos", fields: [professorId], references: [id])
  turmas         Turma[]  @relation("PlanoTurmas")

  @@map("planos_ensino")
}

model AreaConhecimento {
  id           String                @id @default(cuid())
  nome         String
  escolaId     String                @map("escola_id")
  escola       Escola                @relation(fields: [escolaId], references: [id])
  disciplinas  Disciplina[]
  matrices     MatrizCurricular[]
  notas        NotaSimulado[]
  responsaveis ResponsavelSimulado[]
  provas       Prova[]

  @@unique([escolaId, nome])
  @@index([escolaId])
  @@map("areas_conhecimento")
}

model NotaSimulado {
  id                 String           @id @default(cuid())
  estudanteId        String           @map("estudante_id")
  areaId             String?          @map("area_id")
  provaId            String?          @map("prova_id")
  unidade            Int
  nota               Float?
  ausente            Boolean          @default(false)
  notaSegundaChamada Float?           @map("nota_segunda_chamada")
  anoLetivo          Int              @default(2026) @map("ano_letivo")
  lancadoById        String           @map("lancado_by_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  area               AreaConhecimento? @relation(fields: [areaId], references: [id])
  prova              Prova?            @relation(fields: [provaId], references: [id])
  estudante          Estudante        @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  lancadoBy          User             @relation("SimuladoLancador", fields: [lancadoById], references: [id])

  // Removida a constraint de UNIQUE anterior que dependia de areaId, 
  // agora a aplicação precisará gerenciar a unicidade via Prova ou Área
  // @@unique([estudanteId, areaId, unidade, anoLetivo])
  @@map("notas_simulados")
}

model MatrizCurricular {
  id        String            @id @default(cuid())
  nome      String
  cursoId   String            @map("curso_id")
  serie     String
  areaId    String?           @map("area_id")
  anoLetivo Int               @default(2026) @map("ano_letivo")
  area      AreaConhecimento? @relation(fields: [areaId], references: [id])

  @@unique([nome, cursoId, serie, anoLetivo])
  @@map("matrizes_curriculares")
}

model ResponsavelSimulado {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  turmaId   String           @map("turma_id")
  areaId    String?          @map("area_id")
  provaId   String?          @map("prova_id")
  unidade   Int?
  anoLetivo Int              @default(2026) @map("ano_letivo")
  createdAt DateTime         @default(now()) @map("created_at")
  area      AreaConhecimento? @relation(fields: [areaId], references: [id], onDelete: Cascade)
  prova     Prova?            @relation(fields: [provaId], references: [id], onDelete: Cascade)
  turma     Turma            @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("responsaveis_simulados")
}

model Laboratorio {
  id        String               @id @default(cuid())
  nome      String
  escolaId  String               @map("escola_id")
  escola    Escola               @relation(fields: [escolaId], references: [id])
  descricao String?
  reservas  ReservaLaboratorio[]

  @@unique([escolaId, nome])
  @@index([escolaId])
  @@map("laboratorios")
}

model ReservaLaboratorio {
  id            String      @id @default(cuid())
  laboratorioId String      @map("laboratorio_id")
  userId        String      @map("user_id")
  data          DateTime
  turno         String
  horario       Int
  disciplina    String?
  turmaId       String?     @map("turma_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([laboratorioId, data, turno, horario])
  @@map("reservas_laboratorio")
}

model AEEProfile {
  id                       String               @id @default(cuid())
  estudanteId              String               @unique @map("estudante_id")
  cids                     String[]
  condicao                 String
  recomendacoes            String
  notasDirecao             String?
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  precisaProvaAdaptada     Boolean              @default(false) @map("precisa_prova_adaptada")
  precisaProvaSalaEspecial Boolean              @default(false) @map("precisa_prova_sala_especial")
  fotoUrl                  String?              @map("foto_url")
  contatoNome              String?              @map("contato_nome")
  contatoTelefone          String?              @map("contato_telefone")
  acknowledgements         AEEAcknowledgement[]
  estudante                Estudante            @relation("EstudanteAEE", fields: [estudanteId], references: [id], onDelete: Cascade)

  @@map("aee_profiles")
}

model AEEAcknowledgement {
  id        String     @id @default(cuid())
  profileId String     @map("profile_id")
  userId    String     @map("user_id")
  readAt    DateTime   @default(now()) @map("read_at")
  profile   AEEProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([profileId, userId])
  @@map("aee_acknowledgements")
}

enum QuestaoStatus {
  PENDENTE
  APROVADA
  REJEITADA
}

enum Dificuldade {
  FACIL
  MEDIO
  DIFICIL
}

enum StatusNota {
  APROVADO
  RECUPERACAO
  DESISTENTE
  APROVADO_RECUPERACAO
  APROVADO_CONSELHO
  DEPENDENCIA
  CONSERVADO

  @@map("status_nota")
}
