# Database (Use as URLs do Supabase)
DATABASE_URL="postgresql://postgres:[SENHA]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[SENHA]@[HOST]:5432/postgres"

# NextAuth
NEXTAUTH_URL="https://ceteplnab.com.br"
NEXTAUTH_SECRET="gerar-chave-aleatoria"

# Multi-tenant: fallback de dev quando o acesso nao vem por subdominio
# (ex: localhost:3000 direto). Nao usar em producao - la, o subdominio
# sempre resolve a escola.
DEV_ESCOLA_SLUG="cetep"

# Multi-tenant: dominio raiz usado pelo proxy.ts pra extrair o subdominio
# de cada escola (ex: "seusistema.com" resolve "cetep.seusistema.com").
# Em dev local, "localhost" (padrao) permite usar "cetep.localhost:3000".
ROOT_DOMAIN="localhost"

# Testes automatizados (vitest): banco Postgres separado do de dev, pra
# nao sujar dados reais. Ver .env.test (nao versionado - crie o seu com
# base neste exemplo, apontando pro mesmo Postgres local em outro database).
# DATABASE_URL="postgresql://postgres:devpassword@localhost:5433/axis_test"
# DIRECT_URL="postgresql://postgres:devpassword@localhost:5433/axis_test"

# E-mail (Opcional - SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-app"
SMTP_FROM='"Nome do Sistema" <seu-email@gmail.com>'
